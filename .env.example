# LCN connection (PCHK)
LCN_HOST=192.168.1.10
LCN_PORT=4114
LCN_USERNAME=lcn
LCN_PASSWORD=lcn
LCN_NAME=pchk
LCN_DIM_MODE=STEPS200

# MQTT broker
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=0
MQTT_RETAIN=true

# Logging
LOG_LEVEL=INFO

# Module attribute overrides (optional)
# Pattern: CONFIG_{M|G}{SEG:03d}{ADDR:03d}_{HANDLER}{N}[_{ATTR}]=value
#
# Sub-model attributes (Output, Motor):
#   CONFIG_M000007_OUTPUT1_TRANSITION=10     -> module.output1.transition = 10
#   CONFIG_M000007_OUTPUT1_BRIGHTNESS=80     -> module.output1.brightness = 80
#   CONFIG_M000007_OUTPUT1_STATE=on          -> module.output1.state = on
#   CONFIG_M000007_MOTOR1_POSITION=50        -> module.motor1.position = 50
#   CONFIG_M000007_MOTOR1_TILT=30            -> module.motor1.tilt = 30
#
# Scalar attributes (Relay, Led, Var):
#   CONFIG_M000007_RELAY1=on                 -> module.relay1 = on
#   CONFIG_M000007_LED3=blink                -> module.led3 = blink
#   CONFIG_M000007_VAR1=100                  -> module.var1 = 100
