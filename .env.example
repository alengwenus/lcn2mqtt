# LCN connection (PCHK)
LCN2MQTT__LCN__HOST=192.168.1.10
LCN2MQTT__LCN__PORT=4114
LCN2MQTT__LCN__USERNAME=lcn
LCN2MQTT__LCN__PASSWORD=lcn
LCN2MQTT__LCN__NAME=pchk
LCN2MQTT__LCN__DIM_MODE=STEPS200
_
# MQTT broker
LCN2MQTT__MQTT__HOST=mqtt
LCN2MQTT__MQTT__PORT=1883
LCN2MQTT__MQTT__USERNAME=
LCN2MQTT__MQTT__PASSWORD=
LCN2MQTT__MQTT__QOS=0
LCN2MQTT__MQTT__RETAIN=true

# Logging
LCN2MQTT__LOG_LEVEL=INFO

# Home Assistant MQTT Discovery
# LCN2MQTT__HOMEASSISTANT__ENABLED=false          # set to true to publish HA discovery messages on startup
# LCN2MQTT__HOMEASSISTANT__PREFIX=homeassistant   # HA discovery topic prefix
# LCN2MQTT__HOMEASSISTANT__SCAN_MODULES=true      # scan LCN bus for modules before publishing

# Module attribute overrides (optional)
# Pattern: LCN2MQTT__DEVICES__{M|G}{SEG:03d}{ADDR:03d}__{HANDLER}{N}[__{ATTR}]=value
#
# Sub-model attributes (Output, Motor):
#   LCN2MQTT__DEVICES__M000007__OUTPUT1__TRANSITION=10     -> module.output1.transition = 10
#   LCN2MQTT__DEVICES__M000007__OUTPUT1__BRIGHTNESS=80     -> module.output1.brightness = 80
#   LCN2MQTT__DEVICES__M000007__OUTPUT1__STATE=on          -> module.output1.state = on
#   LCN2MQTT__DEVICES__M000007__MOTOR1__POSITION=50        -> module.motor1.position = 50
#
# Scalar attributes (Relay, Led, Var):
#   LCN2MQTT__DEVICES__M000007__RELAY1=on                 -> module.relay1 = on
#   LCN2MQTT__DEVICES__M000007__LED3=blink                -> module.led3 = blink
#   LCN2MQTT__DEVICES__M000007__VAR1=100                  -> module.var1 = 100
