# LCN connection (PCHK)
LCN2MQTT_LCN_HOST=192.168.1.10
LCN2MQTT_LCN_PORT=4114
LCN2MQTT_LCN_USERNAME=lcn
LCN2MQTT_LCN_PASSWORD=lcn
LCN2MQTT_LCN_NAME=pchk
LCN2MQTT_LCN_DIM_MODE=STEPS200

# MQTT broker
LCN2MQTT_MQTT_HOST=mqtt
LCN2MQTT_MQTT_PORT=1883
LCN2MQTT_MQTT_USERNAME=
LCN2MQTT_MQTT_PASSWORD=
LCN2MQTT_MQTT_QOS=0
LCN2MQTT_MQTT_RETAIN=true

# Logging
LCN2MQTT_LOG_LEVEL=INFO

# Home Assistant MQTT Discovery
# DISCOVERY_ENABLED=false          # set to true to publish HA discovery messages on startup
# DISCOVERY_PREFIX=homeassistant   # HA discovery topic prefix
# DISCOVERY_SCAN_MODULES=true      # scan LCN bus for modules before publishing

# Module attribute overrides (optional)
# Pattern: LCN2MQTT_DEVICES_{M|G}{SEG:03d}{ADDR:03d}_{HANDLER}{N}[_{ATTR}]=value
#
# Sub-model attributes (Output, Motor):
#   LCN2MQTT_DEVICES_M000007_OUTPUT1_TRANSITION=10     -> module.output1.transition = 10
#   LCN2MQTT_DEVICES_M000007_OUTPUT1_BRIGHTNESS=80     -> module.output1.brightness = 80
#   LCN2MQTT_DEVICES_M000007_OUTPUT1_STATE=on          -> module.output1.state = on
#   LCN2MQTT_DEVICES_M000007_MOTOR1_POSITION=50        -> module.motor1.position = 50
#   LCN2MQTT_DEVICES_M000007_MOTOR1_TILT=30            -> module.motor1.tilt = 30
#
# Scalar attributes (Relay, Led, Var):
#   LCN2MQTT_DEVICES_M000007_RELAY1=on                 -> module.relay1 = on
#   LCN2MQTT_DEVICES_M000007_LED3=blink                -> module.led3 = blink
#   LCN2MQTT_DEVICES_M000007_VAR1=100                  -> module.var1 = 100
